# ============================================================
# Environment template
# - Root .env        → docker-compose (db credentials + secrets)
# - backend/.env     → local dev for the Express API
# - .env.production  → Vite build-time vars baked into frontend
# ============================================================

# ---------- Docker / shared ----------
# Per-client deployments: STACK_PREFIX names the containers (<prefix>-api/-db),
# COMPOSE_PROJECT_NAME isolates volumes, API_PORT must be unique per instance.
STACK_PREFIX=gpt
COMPOSE_PROJECT_NAME=gpt
API_BIND=127.0.0.1
API_PORT=5055

POSTGRES_DB=abt_tracker
POSTGRES_USER=abt_user
POSTGRES_PASSWORD=change-me-strong-password

JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
# "*.vercel.app" covers every Vercel preview/production URL.
CORS_ORIGIN=http://localhost:5173,https://gptapp.vercel.app,*.vercel.app
SOCKET_CORS_ORIGIN=http://localhost:5173,https://gptapp.vercel.app,*.vercel.app

# One-time seeding (POST /api/seed requires this once an admin exists)
SEED_KEY=
ADMIN_EMAIL=admin@gpt.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Government
ADMIN_LAST_NAME=Administrator

# ---------- White-label instance defaults ----------
# Baseline for GET /api/instance; admins can override via PUT /api/instance.
# Leave blank to use built-in defaults.
INSTANCE_NAME=
INSTANCE_LOGO_URL=
INSTANCE_BRAND_COLOR=
INSTANCE_SIDEBAR_COLOR=
INSTANCE_CURRENCY=
INSTANCE_AREA_LABEL=
INSTANCE_AREA_LABEL_PLURAL=
INSTANCE_CONTACT_EMAIL=
INSTANCE_FOOTER_ORG=
# Provider-controlled module licences, JSON overrides on all-on defaults.
# Keys: publicPortal, map, analytics, reports, progress. Not admin-editable.
# Example: INSTANCE_FEATURES={"map":false,"analytics":false}
INSTANCE_FEATURES=

# ---------- Offsite backup sync ----------
# When all four are set, daily pg_dumps also sync to S3-compatible storage
# (AWS S3, Cloudflare R2, Backblaze, MinIO) via sync-backups.sh.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=

# ---------- Password-reset email ----------
# Without SMTP, reset links are written to the API logs instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=

# ---------- Backend (local dev) ----------
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://abt_user:change-me-strong-password@localhost:5432/abt_tracker
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ---------- Frontend (Vite) ----------
# API base URL baked into the production build
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
