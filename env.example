# ============================================================
# Environment template
# - Root .env        → docker-compose (db credentials + secrets)
# - backend/.env     → local dev for the Express API
# - .env.production  → Vite build-time vars baked into frontend
# ============================================================

# ---------- Docker / shared ----------
POSTGRES_DB=abt_tracker
POSTGRES_USER=abt_user
POSTGRES_PASSWORD=change-me-strong-password

API_PORT=5000
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
# "*.vercel.app" covers every Vercel preview/production URL.
CORS_ORIGIN=http://localhost:5173,https://gptapp.vercel.app,*.vercel.app
SOCKET_CORS_ORIGIN=http://localhost:5173,https://gptapp.vercel.app,*.vercel.app

# One-time seeding (POST /api/seed requires this once an admin exists)
SEED_KEY=
ADMIN_EMAIL=admin@gpt.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Government
ADMIN_LAST_NAME=Administrator

# ---------- Backend (local dev) ----------
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://abt_user:change-me-strong-password@localhost:5432/abt_tracker
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ---------- Frontend (Vite) ----------
# API base URL baked into the production build
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
